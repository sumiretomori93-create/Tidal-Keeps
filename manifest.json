{
  "schema_version": 1,
  "toolpkg_id": "com.reiko.tidal_keeps",
  "version": "0.2.2",
  "author": [
    "Reiko",
    "Gabe"
  ],
  "main": "main.js",
  "display_name": {
    "zh": "潮汐留存",
    "en": "Tidal Keeps",
    "default": "Tidal Keeps"
  },
  "description": {
    "zh": "把日常沉入海里，再从昨日打捞回来。",
    "en": "Sink daily life into the sea and bring yesterday back every morning.",
    "default": "A shared life-state space with morning handoffs."
  },
  "enabled_by_default": true,
  "subpackages": [
    {
      "id": "tidal_keeps_core",
      "entry": "packages/tidal_keeps_core.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "潮汐留存核心",
        "en": "Tidal Keeps Core"
      },
      "description": {
        "zh": "保存记录、日程、经期与晨间交接。",
        "en": "Stores records, events, cycle data, and morning digests."
      }
    }
  ],
  "api_version": "1.0.1",
  "resources": [
    {
      "key": "morning_dive_workflow_template",
      "path": "resources/workflows/morning_dive_workflow.json",
      "mime": "application/json"
    }
  ],
  "workflow_templates": [
    {
      "id": "morning_dive_workflow",
      "display_name": {
        "zh": "晨潜 · 每日交接",
        "en": "Morning Dive · Daily Handoff"
      },
      "description": {
        "zh": "每天 08:00 触发潮汐留存，将当日晨间交接送入已绑定对话。",
        "en": "Runs at 08:00 daily and delivers the Tidal Keeps morning handoff to the bound chat."
      },
      "resource_key": "morning_dive_workflow_template"
    }
  ]
}
